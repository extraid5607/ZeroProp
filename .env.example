# These are environment variables: export them in your shell (export NAME=value) or set them in
# your host's dashboard. The app does not read a .env file by itself. Every setting is optional.

# "live" = real prices (CCXT for crypto and metals, Yahoo Finance for forex)
# "demo" = simulated prices that move fast; works with no internet, good for testing
PRICE_SOURCE=live

# Database. SQLite file by default. On a host, use PostgreSQL so data survives restarts:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./zeropaper.db

# Set to true when the site is served over HTTPS (it should be, in production)
COOKIE_SECURE=false

APP_NAME=ZeroProp
START_BALANCE=10000

# Exchanges tried in order for crypto prices. If one is blocked or down, the next is used.
CRYPTO_VENUES=binance,bybit,okx,kucoin
# Exchanges tried first for gold/silver (Yahoo Finance is the fallback)
METAL_VENUES=binanceusdm

# Leaderboard: a trader appears after this many closed trades
MIN_TRADES_LEADERBOARD=5
MAX_OPEN_POSITIONS=10
SESSION_DAYS=30

# Starting values for each new account's own risk rules (users can change them on the Rules page)
DEFAULT_MAX_LEVERAGE=20
DEFAULT_MAX_RISK_PCT=5
DEFAULT_DAILY_LOSS_PCT=10
